# Source, scripts, configuration, and documentation use stable LF endings.
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.cpp text eol=lf
*.patch text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.in text eol=lf
*.lock text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Evidence is byte-for-byte board output; do not normalize line endings.
evidence/raw/** -text
